
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    // Perfiles privados y puntos
    match /usuarios/{userId} {
      allow read: if isOwner(userId);

      function validName(name) {
        return name is string && name.size() <= 40 && name.matches('.*\\S.*');
      }

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['nombre', 'correo', 'puntos', 'fechaCreacion'])
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'puntos', 'fechaCreacion'])
        && validName(request.resource.data.nombre)
        && request.resource.data.correo is string
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.puntos is int
        && request.resource.data.puntos == 0
        && request.resource.data.fechaCreacion == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && validName(request.resource.data.nombre);
    }

    // Búsqueda de perfiles públicos
    match /perfilesPublicos/{userId} {
      allow read: if signedIn();

      // Evitar suplantaciones y cambios arbitrarios.
      allow create, update, delete: if false;
    }

    // Apuestas
    match /apuestas/{betId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      // Las operaciones sobre apuestas y botes
      // requieren validación de integridad.
      allow create, update, delete: if false;
    }

    // Invitaciones
    match /invitaciones/{invitationId} {
      allow read: if signedIn()
        && (
          resource.data.inviterId == request.auth.uid
          || resource.data.inviteeId == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    // Cualquier otra ruta queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
