# Normalización de finales de línea
* text=auto

# Scripts para Linux/macOS
gradlew text eol=lf
*.sh text eol=lf

# Scripts para Windows
*.bat text eol=crlf

# Archivos binarios
*.jar binary

# Firebase
firebase.json text eol=lf
firestore.rules text eol=lf
firestore.indexes.json text eol=lf

# Pruebas de Firebase
*.cjs text eol=lf